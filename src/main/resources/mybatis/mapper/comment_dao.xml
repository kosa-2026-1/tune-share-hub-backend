<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tune_share_hub_backend.dao.playlist.CommentDao">
    <insert id="insertComment" parameterType="com.example.tune_share_hub_backend.entity.Comment">
        INSERT INTO COMMENTS (
            COMMENT_ID, PLAYLIST_ID, USER_ID, CONTENT
        ) VALUES (
            COMMENTS_SEQ.NEXTVAL,
            #{comment.playlistId},
            #{comment.userId},
            #{comment.content}
        )
    </insert>

    <select id="findById" parameterType="long" resultType="com.example.tune_share_hub_backend.entity.Comment">
        SELECT * FROM COMMENTS
        WHERE COMMENT_ID = #{commentId}
    </select>

    <update id="updateComment" parameterType="com.example.tune_share_hub_backend.entity.Comment">
        UPDATE COMMENTS
        SET CONTENT = #{comment.content},
            UPDATED_AT = SYSTIMESTAMP
        WHERE COMMENT_ID = #{comment.commentId}
          AND USER_ID = #{comment.userId}
    </update>

    <delete id="deleteComment" parameterType="long">
        DELETE FROM COMMENTS
        WHERE COMMENT_ID = #{commentId}
    </delete>
</mapper>
