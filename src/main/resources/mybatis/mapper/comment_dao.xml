<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tune_share_hub_backend.dao.playlist.CommentDao">

    <resultMap id="CommentResultMap" type="Comment">
        <id property="commentId" column="COMMENT_ID"/>
        <result property="playlistId" column="PLAYLIST_ID"/>
        <result property="userId" column="USER_ID"/>
        <result property="userNickname" column="USER_NICKNAME"/>
        <result property="content" column="CONTENT"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
    </resultMap>

    <insert id="insertComment">
        INSERT INTO COMMENTS (
            COMMENT_ID,
            PLAYLIST_ID,
            USER_ID,
            USER_NICKNAME,
            CONTENT,
            CREATED_AT,
            UPDATED_AT
        ) VALUES (
            SEQ_COMMENTS.NEXTVAL,
            #{comment.playlistId},
            #{comment.userId},
            #{comment.userNickname},
            #{comment.content},
            SYSTIMESTAMP,
            SYSTIMESTAMP
        )
    </insert>

    <select id="findById" parameterType="long" resultMap="CommentResultMap">
        SELECT *
        FROM COMMENTS
        WHERE COMMENT_ID = #{commentId}
    </select>

    <update id="updateComment">
        UPDATE COMMENTS
        SET CONTENT = #{comment.content},
            UPDATED_AT = SYSTIMESTAMP
        WHERE COMMENT_ID = #{comment.commentId}
    </update>

    <delete id="deleteComment" parameterType="long">
        DELETE FROM COMMENTS
        WHERE COMMENT_ID = #{commentId}
    </delete>

    <select id="findByPlaylistId" parameterType="long" resultMap="CommentResultMap">
        SELECT * FROM COMMENTS
        WHERE PLAYLIST_ID = #{playlistId}
        ORDER BY CREATED_AT ASC
    </select>

</mapper>
