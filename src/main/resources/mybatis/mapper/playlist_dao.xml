<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tune_share_hub_backend.dao.PlaylistMapperDao">

    <resultMap id="PlaylistResultMap" type="com.example.tune_share_hub_backend.entity.Playlist">
        <id     property="playlistId"    column="PLAYLIST_ID"/>
        <result property="userId"        column="USER_ID"/>
        <result property="title"         column="TITLE"/>
        <result property="description"   column="DESCRIPTION"/>
        <result property="coverImageUrl" column="COVER_IMAGE_URL"/>
        <result property="publicYn"      column="PUBLIC_YN"/>
        <result property="viewCount"     column="VIEW_COUNT"/>
        <result property="likeCount"     column="LIKE_COUNT"/>
        <result property="commentCount"  column="COMMENT_COUNT"/>
        <result property="createdAt"     column="CREATED_AT"/>
        <result property="updatedAt"     column="UPDATED_AT"/>
        <result property="deletedAt"     column="DELETED_AT"/>
    </resultMap>

    <!-- MVP-4: 생성 -->
<insert id="insert" parameterType="com.example.tune_share_hub_backend.entity.Playlist">
    INSERT INTO PLAYLISTS (
        PLAYLIST_ID, USER_ID, TITLE, DESCRIPTION,
        COVER_IMAGE_URL, PUBLIC_YN
    ) VALUES (
        (SELECT NVL(MAX(PLAYLIST_ID), 0) + 1 FROM PLAYLISTS),
        #{userId}, #{title}, #{description},
        #{coverImageUrl}, #{publicYn}
    )
</insert>
    <!-- MVP-5: 내 플레이리스트 목록 -->
    <select id="findByUserId" parameterType="long" resultMap="PlaylistResultMap">
        SELECT * FROM PLAYLISTS
        WHERE USER_ID = #{userId}
          AND DELETED_AT IS NULL
        ORDER BY CREATED_AT DESC
    </select>

    <!-- MVP-6: 상세 조회 -->
    <select id="findById" parameterType="long" resultMap="PlaylistResultMap">
        SELECT * FROM PLAYLISTS
        WHERE PLAYLIST_ID = #{playlistId}
          AND DELETED_AT IS NULL
    </select>

</mapper>
